# ---------------------------------------------------------------------------
# Kindle Jr 5.0 — Backend environment
# Copy to .env for local development, or set these as service variables in
# Railway / Cloud Run. Never commit a real .env.
# ---------------------------------------------------------------------------

PORT=8080

# --- Firebase / Firestore -------------------------------------------------
# Must match the project_id inside the service-account JSON below.
FIREBASE_PROJECT_ID=kindle-jr-5-prod-b2007

# --- Google credentials (single source for Firestore AND Sheets) ----------
# Base64-encoded service-account JSON. The backend decodes this in memory and
# never reads a key file from disk, which is what makes container deploys work.
#
# Generate with:
#   Windows: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
#   macOS/Linux: base64 -w0 key.json
GOOGLE_SHEETS_CREDENTIALS_BASE64=

# Optional: raw JSON alternative, used only if the Base64 var is empty.
# GOOGLE_SERVICE_ACCOUNT_BASE64=

# Local development only (ignored when Base64 credentials are present).
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- Google Sheets live leaderboard --------------------------------------
# 44-character spreadsheet id taken from the sheet URL:
# https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Leaderboard
# Numeric tab id (gid). 0 is the first tab.
GOOGLE_SHEET_GID=0

# --- Admin API protection -------------------------------------------------
# Must equal NEXT_PUBLIC_ADMIN_SECRET in the frontend build.
ADMIN_SECRET=kindle_jr_5_admin_secret_2026

# --- Persistence ----------------------------------------------------------
# Directory for the resilient local JSON mirror. Mount a volume here on
# Railway so un-synced answers survive a redeploy.
DATA_PATH=./data
