# Backend Server Configuration
PORT=8080

# Firestore Database Configuration
FIREBASE_PROJECT_ID=kindle-jr-5-prod
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-admin.json

# Shared Credentials (Base64-encoded service-account JSON — preferred for production)
# Used by both Firestore init and Google Sheets exporter
GOOGLE_SHEETS_CREDENTIALS_BASE64=eyJ0eXBlIjoic2Vyd...

# Google Sheets Export Configuration
GOOGLE_SHEET_ID=your-google-sheet-id

# Admin API Protection
ADMIN_SECRET=super_secure_admin_key_123

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8080/api
