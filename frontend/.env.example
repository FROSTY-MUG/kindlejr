# Frontend environment — copy to .env.local for development.

# Base URL of the Go backend API.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Master admin dashboard key. This MUST match ADMIN_SECRET in backend/.env,
# otherwise the dashboard receives 401s and renders an empty table.
NEXT_PUBLIC_ADMIN_SECRET=kindle_jr_5_admin_secret_2026
